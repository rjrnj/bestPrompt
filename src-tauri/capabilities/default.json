{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "clipboard-manager:allow-write-text",
    "allow-list-frameworks",
    "allow-get-framework",
    "allow-create-framework",
    "allow-update-framework",
    "allow-delete-framework",
    "allow-restore-framework",
    "allow-save-prompt-entry",
    "allow-list-prompt-entries",
    "allow-get-prompt-entry",
    "allow-set-entry-title",
    "allow-set-entry-project",
    "allow-delete-prompt-entry",
    "allow-latest-entry-project",
    "allow-list-projects",
    "allow-create-project",
    "allow-set-project-folder",
    "allow-rename-project",
    "allow-delete-project",
    "allow-claude-status",
    "allow-detect-claude",
    "allow-pick-folder",
    "allow-start-session",
    "allow-write-session",
    "allow-resize-session",
    "allow-paste-clipboard",
    "allow-close-session"
  ]
}
